{
  "name": "free-qr-code-creator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 43123 --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/prerender-seo.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview --port 43123 --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "jsbarcode": "^3.12.1",
    "jszip": "^3.10.1",
    "qr-code-styling": "^1.9.2",
    "qr-scanner": "^1.4.2",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "jiti": "^2.4.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.30.0"
  }
}
